<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/main_background"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/birthday_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:background="@android:drawable/toast_frame"
        android:backgroundTint="#1976D2"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎂 AUGURI LUCA! 🥳"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/birthday_banner">

        <ImageButton
            android:id="@+id/btn_moduli_reparto"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_toStartOf="@id/btn_change_folder"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_agenda"
            android:tint="@color/main_text"
            android:contentDescription="Moduli Reparto" />

        <ImageButton
            android:id="@+id/btn_change_folder"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_save"
            android:tint="@color/main_text"
            android:contentDescription="@string/cambia_cartella" />

        <ImageButton
            android:id="@+id/btn_open_generator"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_toStartOf="@id/btn_change_folder"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_lock_lock"
            android:tint="@color/main_text"
            android:visibility="gone"
            android:contentDescription="Generatore Codici" />
    </RelativeLayout>

    <ScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/layout_buttons"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:backgroundTint="@color/input_background"
                    android:orientation="vertical"
                    android:padding="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reparto" android:textSize="12sp" android:textColor="@color/label_color" android:layout_marginStart="8dp"/>
                    <Spinner android:id="@+id/spinner_scelte" android:layout_width="match_parent" android:layout_height="40dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:backgroundTint="@color/input_background"
                    android:orientation="vertical"
                    android:padding="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/turno" android:textSize="12sp" android:textColor="@color/label_color" android:layout_marginStart="8dp"/>
                    <Spinner android:id="@+id/spinner_turno" android:layout_width="match_parent" android:layout_height="40dp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_nome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@android:drawable/btn_dropdown"
                android:backgroundTint="@color/input_background"
                android:orientation="vertical"
                android:padding="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nome" android:textSize="12sp" android:textColor="@color/label_color" android:layout_marginStart="8dp"/>
                <Spinner android:id="@+id/spinner_nome" android:layout_width="match_parent" android:layout_height="40dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <EditText android:id="@+id/input_gg" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/hint_gg" android:gravity="center" android:inputType="number" android:background="@android:drawable/editbox_background" android:backgroundTint="@color/input_background" android:textColor="@color/main_text" android:textColorHint="@color/label_color" android:focusable="false" android:clickable="true" />
                <EditText android:id="@+id/input_mm" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/hint_mm" android:gravity="center" android:inputType="number" android:background="@android:drawable/editbox_background" android:backgroundTint="@color/input_background" android:textColor="@color/main_text" android:textColorHint="@color/label_color" android:focusable="false" android:clickable="true" />
                <EditText android:id="@+id/input_aaaa" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:hint="@string/hint_aaaa" android:gravity="center" android:inputType="number" android:background="@android:drawable/editbox_background" android:backgroundTint="@color/input_background" android:textColor="@color/main_text" android:textColorHint="@color/label_color" android:focusable="false" android:clickable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/label_inserimento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/inserimento_attivita"
                android:textStyle="bold"
                android:textColor="@color/main_text"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/editbox_background"
                android:backgroundTint="@color/input_background"
                android:orientation="vertical"
                android:padding="8dp">
                <AutoCompleteTextView
                    android:id="@+id/input_descrizione"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_descrizione"
                    android:textColor="@color/main_text"
                    android:textColorHint="@color/label_color"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:background="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/label_ore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ore_label"
                        android:textColor="@color/main_text"/>
                    <EditText
                        android:id="@+id/input_ore"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:hint="0"
                        android:textColor="@color/main_text"
                        android:inputType="time"
                        android:digits="0123456789:"
                        android:gravity="center" />

                    <TextView android:id="@+id/label_straordinario_angelo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ore Straordinario:"
                        android:visibility="gone"
                        android:textColor="@color/main_text"/>
                    <EditText
                        android:id="@+id/input_straordinario_angelo"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:hint="0"
                        android:visibility="gone"
                        android:textColor="@color/main_text"
                        android:inputType="time"
                        android:digits="0123456789:"
                        android:gravity="center" />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_straordinario_veloce"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+30 min"
                        android:textSize="10sp"
                        android:visibility="gone"
                        tools:visibility="visible"
                        app:backgroundTint="#673AB7" />

                    <Button
                        android:id="@+id/btn_clear_all"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PULISCI TUTTO"
                        android:textSize="10sp"
                        app:backgroundTint="#D32F2F" />

                    <Button
                        android:id="@+id/add_activity_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/aggiungi_button"
                        app:backgroundTint="#2E7D32" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/text_ore_restanti"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Restanti: 7:42"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:gravity="start"/>
                <TextView
                    android:id="@+id/text_ore_totali"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/totale_ore_default"
                    android:textStyle="bold"
                    android:textColor="@color/main_text"
                    android:gravity="end"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">
                <TextView
                    android:id="@+id/text_straordinario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/straordinario_default"
                    android:textStyle="bold"
                    android:textColor="#D32F2F"
                    android:visibility="gone"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_attivita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layout_buttons"
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/create_pdf_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/crea_pdf_button"
            app:backgroundTint="#FF9800" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/history_button"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:layout_marginEnd="4dp"
                android:text="@string/storico_button"
                android:textColor="@color/main_text" />

            <Button
                android:id="@+id/load_yesterday_button"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:layout_marginEnd="4dp"
                android:text="CARICA COME IERI"
                android:textColor="@color/main_text" />

            <Button
                android:id="@+id/exit_button"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:text="@string/esci_button"
                android:textColor="@color/main_text" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
