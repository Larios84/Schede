<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    android:padding="4dp">

    <!-- Header Input -->
    <LinearLayout
        android:id="@+id/header_inputs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Sezione Data -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/input_gg"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/input_background"
                    android:gravity="center"
                    android:hint="GG"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:padding="0dp"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/input_mm"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/input_background"
                    android:gravity="center"
                    android:hint="MM"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:padding="0dp"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/input_aaaa"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1.5"
                    android:backgroundTint="@color/input_background"
                    android:gravity="center"
                    android:hint="AAAA"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:padding="0dp"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Spazio tra data e ora -->
            <View
                android:layout_width="16dp"
                android:layout_height="1dp" />

            <!-- Sezione Ora -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/input_ora"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:backgroundTint="@color/input_background"
                    android:gravity="center"
                    android:hint="HH"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:padding="0dp"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textColor="@color/main_text"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/input_min"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:backgroundTint="@color/input_background"
                    android:gravity="center"
                    android:hint="MM"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:padding="0dp"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Configurazione Section -->
    <LinearLayout
        android:id="@+id/config_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:background="#11000000"
        android:orientation="vertical"
        android:padding="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_inputs">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:text="Configurazione"
            android:textColor="@color/label_color"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- DAY / STR -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_day"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:backgroundTint="#E0E0E0"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="DAY"
                    android:textColor="@android:color/black"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_str"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:backgroundTint="#E0E0E0"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="STR"
                    android:textColor="@android:color/black"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- NIGHT / CAT I -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_night"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:backgroundTint="#E0E0E0"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="NIGHT"
                    android:textColor="@android:color/black"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_cati"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:backgroundTint="#E0E0E0"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="CAT I"
                    android:textColor="@android:color/black"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 14 / 32 -->
            <Button
                android:id="@+id/btn_area14"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:backgroundTint="#E0E0E0"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="14"
                android:textColor="@android:color/black"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_area32"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:backgroundTint="#E0E0E0"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="32"
                android:textColor="@android:color/black"
                android:textSize="14sp" />

            <!-- SB ON / SB OFF -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_sbon"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:backgroundTint="#E0E0E0"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="SB ON"
                    android:textAllCaps="false"
                    android:textColor="@android:color/black"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_sboff"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:backgroundTint="#E0E0E0"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="SB OFF"
                    android:textAllCaps="false"
                    android:textColor="@android:color/black"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Standard Bar (0-5) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="Standard"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btn_step0"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:backgroundTint="#F5F5F5"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="0"
                android:textColor="@android:color/black"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_step1"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:backgroundTint="#F5F5F5"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="1"
                android:textColor="@android:color/black"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_step2"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:backgroundTint="#F5F5F5"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="2"
                android:textColor="@android:color/black"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_step3"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:backgroundTint="#F5F5F5"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="3"
                android:textColor="@android:color/black"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_step4"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:backgroundTint="#F5F5F5"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="4"
                android:textColor="@android:color/black"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_step5"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:backgroundTint="#F5F5F5"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="5"
                android:textColor="@android:color/black"
                android:textSize="12sp" />

            <View
                android:layout_width="2dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btn_fs"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:backgroundTint="#F5F5F5"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="FS"
                android:textColor="@android:color/black"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Table Labels -->
    <LinearLayout
        android:id="@+id/table_labels"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#22000000"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/config_container">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="Circuito"
            android:textColor="@color/label_color"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Carico"
            android:textColor="@color/label_color"
            android:textSize="10sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Amp"
            android:textColor="@color/label_color"
            android:textSize="10sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Volt"
            android:textColor="@color/label_color"
            android:textSize="10sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="center"
            android:text="Iso"
            android:textColor="@color/label_color"
            android:textSize="10sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_urcc"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toTopOf="@id/input_note"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/table_labels" />

    <EditText
        android:id="@+id/input_note"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/input_background"
        android:gravity="top"
        android:hint="Note aggiuntive (verranno divise su più righe nel PDF)"
        android:imeOptions="actionDone"
        android:inputType="textMultiLine"
        android:lines="2"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/button_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_save_urcc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#FF9800"
            android:text="SALVA E GENERA PDF" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
