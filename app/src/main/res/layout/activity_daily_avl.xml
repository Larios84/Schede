<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    android:padding="8dp">

    <!-- Header: Data e Ora -->
    <LinearLayout
        android:id="@+id/header_daily"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/input_gg"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:hint="@string/hint_gg"
            android:inputType="number"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/input_mm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:hint="@string/hint_mm"
            android:inputType="number"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/input_aaaa"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.5"
            android:gravity="center"
            android:hint="@string/hint_aaaa"
            android:inputType="number"
            android:textSize="16sp" />

        <View
            android:layout_width="16dp"
            android:layout_height="1dp" />

        <EditText
            android:id="@+id/input_ora"
            android:layout_width="50dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:hint="HH"
            android:inputType="number"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_min"
            android:layout_width="50dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:hint="MM"
            android:inputType="number"
            android:textSize="16sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_daily"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/label_note_gen"
        app:layout_constraintTop_toBottomOf="@id/header_daily" />

    <TextView
        android:id="@+id/label_note_gen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_note_generali"
        android:textColor="@color/main_text"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/input_note_generali"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/input_note_generali"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="top"
        android:hint="Osservazioni generali..."
        android:inputType="textMultiLine"
        android:lines="3"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/btn_save_daily" />

    <Button
        android:id="@+id/btn_save_daily"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#FF9800"
        android:text="@string/btn_salva_daily"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
