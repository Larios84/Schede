<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@android:drawable/editbox_background"
    android:backgroundTint="@color/input_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Titolo Trasferta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_titolo_trasferta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Trasferta 1"
            android:textColor="@color/main_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_oggi_trasferta"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minHeight="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="OGGI"
            android:textSize="10sp"
            android:textColor="@color/main_text" />
    </LinearLayout>

    <!-- Riga 1: Giorno e Km -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giorno"
                android:textColor="@color/label_color"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/input_giorno_zi"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="2dp"
                android:background="@android:drawable/editbox_background"
                android:backgroundTint="@color/main_background"
                android:gravity="center_vertical"
                android:hint="gg/mm/aaaa"
                android:inputType="date"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/main_text"
                android:textColorHint="@color/label_color"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Km Percorsi"
                android:textColor="@color/label_color"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/input_km_zi"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="2dp"
                android:background="@android:drawable/editbox_background"
                android:backgroundTint="@color/main_background"
                android:gravity="center"
                android:hint="0"
                android:inputType="numberDecimal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/main_text"
                android:textColorHint="@color/label_color"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Riga 2: Percorso -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Percorso (es. Cagliari - Elmas - Cagliari)"
            android:textColor="@color/label_color"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/input_percorso_zi"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="2dp"
            android:background="@android:drawable/editbox_background"
            android:backgroundTint="@color/main_background"
            android:gravity="center_vertical"
            android:hint="Percorso APT / X / APT"
            android:inputType="textCapWords"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/main_text"
            android:textColorHint="@color/label_color"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Riga 3: Motivazione -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Motivazione"
            android:textColor="@color/label_color"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/input_motivazione_zi"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="2dp"
            android:background="@android:drawable/editbox_background"
            android:backgroundTint="@color/main_background"
            android:gravity="center_vertical"
            android:hint="Motivazione del servizio"
            android:inputType="textCapSentences"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/main_text"
            android:textColorHint="@color/label_color"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
