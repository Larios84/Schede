<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@android:drawable/editbox_background"
    android:backgroundTint="@color/input_background"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Riga 1: Titolo Trasferta, Data e Km -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_item_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#1"
            android:textColor="@color/purple_500"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_item_data"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="28/09/2026"
            android:textColor="@color/main_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_item_km"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="25 km"
            android:textColor="@color/main_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_item_modifica"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Modifica"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/main_text" />

        <ImageButton
            android:id="@+id/btn_item_elimina"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Elimina"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#D32F2F" />

    </LinearLayout>

    <!-- Riga 2: Percorso -->
    <TextView
        android:id="@+id/tv_item_percorso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Percorso: Cagliari - Elmas - Cagliari"
        android:textColor="@color/main_text"
        android:textSize="13sp" />

    <!-- Riga 3: Motivazione -->
    <TextView
        android:id="@+id/tv_item_motivazione"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Motivazione: Manutenzione"
        android:textColor="@color/label_color"
        android:textSize="12sp" />

</LinearLayout>
